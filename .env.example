# Copy to .env at the repo root for local development. Vercel sets these in its dashboard instead.
# README.md explains where each value comes from.

# --- Database (Neon) -----------------------------------------------------------------------
# Pooled connection string (host contains "-pooler"). Used by the app. Paste Neon's string as is:
# the app upgrades remote connections to sslmode=verify-full (certificate checked).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/ceomaker?sslmode=require
# Direct connection string (same host without "-pooler"). Used for migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/ceomaker?sslmode=require
DATABASE_POOL_MAX=5

# Integration tests. The database name must end in _test, because the tests wipe its tables.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/ceomaker_test?sslmode=require

# --- Auth ----------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Sign-in links by email (Resend). Locally you can leave both empty: links print in the terminal.
# Production needs a key. Until you verify a domain in Resend, it only delivers to your own
# Resend account address (from onboarding@resend.dev).
# RESEND_API_KEY=
# EMAIL_FROM=CEOMaker <signin@yourdomain.com>

# "Continue with Google" appears only when both are set. README.md has the setup steps.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- AI ------------------------------------------------------------------------------------
# Claude drafts the first version of each site. Without a key, drafts are built from the
# answers alone and headline rewrites use fixed suggestions.
# ANTHROPIC_API_KEY=

# --- URLs ----------------------------------------------------------------------------------
# Optional. Defaults to http://localhost:3000 locally and is derived automatically on Vercel.
# APP_URL=http://localhost:3000

# Leave unset until you own a domain: customer sites are served at /sites/<name>.
# Setting it switches to subdomains (ROOT_DOMAIN=ceomaker.com -> amelia.ceomaker.com).
# To try subdomain mode locally: ROOT_DOMAIN=localhost:3000, then open http://demo.localhost:3000
# ROOT_DOMAIN=

# --- Custom domains ------------------------------------------------------------------------
# Customers' own domains are added to the Vercel project through Vercel's API. Leave these
# unset locally: development simulates that part and only checks DNS. Production without them
# shows "Custom domains aren't available yet". README.md has the setup steps.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...
# Optional: give customers a hostname of yours for www (e.g. sites.ceomaker.co, itself a CNAME
# to cname.vercel-dns.com) so you can move hosting later without them editing DNS.
# CUSTOM_DOMAIN_CNAME=
# Protects the scheduled domain check (/api/cron/domains). Any long random string.
# CRON_SECRET=
