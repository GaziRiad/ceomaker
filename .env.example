# Copy to .env at the repo root for local development. Hosted environments set these directly.

# Postgres. In serverless deployments use the pooled connection string (Neon / Supabase pooler).
DATABASE_URL=postgres://ceomaker:ceomaker@127.0.0.1:5432/ceomaker
DATABASE_POOL_MAX=5

# Integration tests. The database name must end in _test: tests truncate its tables.
TEST_DATABASE_URL=postgres://ceomaker:ceomaker@127.0.0.1:5432/ceomaker_test

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the product (landing page + dashboard).
APP_URL=http://localhost:3000
# Customer sites are served at <subdomain>.<ROOT_DOMAIN>. Include the port locally.
ROOT_DOMAIN=localhost:3000
