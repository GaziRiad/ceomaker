{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @ceomaker/db db:migrate && pnpm build",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/domains",
      "schedule": "17 6 * * *"
    },
    {
      "path": "/api/cron/media",
      "schedule": "43 3 * * *"
    },
    {
      "path": "/api/cron/gifts",
      "schedule": "29 4 * * *"
    }
  ]
}
