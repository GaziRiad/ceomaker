{
  "name": "ceomaker",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ceomaker/db db:generate",
    "db:migrate": "pnpm --filter @ceomaker/db db:migrate",
    "db:seed": "pnpm --filter @ceomaker/db db:seed"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}
